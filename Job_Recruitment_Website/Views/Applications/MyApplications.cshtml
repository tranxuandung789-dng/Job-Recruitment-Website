@model IEnumerable<Job_Recruitment_Website.Models.APPLICATION>

@{
    ViewBag.Title = "Việc làm đã nộp";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<div class="container my-4">
    <h3 class="mb-4">Danh sách công việc đã ứng tuyển</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên công việc</th>
                    <th>Công ty</th>
                    <th>Ngày nộp</th>
                    <th>File CV</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">Bạn chưa nộp hồ sơ vào công việc nào.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a href="@Url.Action("Details", "Jobs", new { id = item.JobId })" class="text-decoration-none text-dark">
                                    <strong>@item.JOB.Title</strong>
                                </a>
                            </td>
                            <td>@(item.JOB.COMPANy != null ? item.JOB.COMPANy.CompanyName : "Đang cập nhật")</td>
                            <td>@item.AppliedDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.CANDIDATEPROFILE != null && !string.IsNullOrEmpty(item.CANDIDATEPROFILE.CV_Url))
                                {
                                    <a href="@Url.Content(item.CANDIDATEPROFILE.CV_Url)" target="_blank" class="btn btn-sm btn-outline-info">Xem CV</a>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa có CV</span>
                                }
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case "Pending":
                                    case "Submitted":
                                        <span class="badge bg-secondary">Đã nộp</span>
                                        break;
                                    case "Reviewed":
                                        <span class="badge bg-info text-dark">Đã được xem xét</span>
                                        break;
                                    case "Interview":
                                        <span class="badge bg-primary">Mời phỏng vấn</span>
                                        break;
                                    case "Accepted":
                                    case "Approved":
                                        <span class="badge bg-success">Đã được duyệt</span>
                                        break;
                                    case "Rejected":
                                        <span class="badge bg-danger">Bị từ chối</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@item.Status</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>