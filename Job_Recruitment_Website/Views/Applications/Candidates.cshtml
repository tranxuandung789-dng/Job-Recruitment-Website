@model IEnumerable<Job_Recruitment_Website.Models.APPLICATION>

@{
    ViewBag.Title = "Danh sách ứng viên";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Hồ sơ ứng viên: <span class="text-primary">@ViewBag.JobTitle</span></h3>
        <a href="@Url.Action("MyJobs", "Jobs")" class="btn btn-outline-secondary">Quay lại danh sách tin</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 py-2 small fw-semibold mb-3">✔ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 py-2 small fw-semibold mb-3">⚠ @TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle bg-white">
            <thead class="table-light">
                <tr>
                    <th>Họ và tên</th>
                    <th>Email / SĐT</th>
                    <th>Ngày nộp</th>
                    <th>Hồ sơ / Thư giới thiệu</th>
                    <th class="text-center">Trạng thái hiện tại</th>
                    <th class="text-center" style="min-width: 230px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có ứng viên nào nộp hồ sơ vào vị trí này.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.USER.FullName</strong></td>
                            <td>
                                <div>@item.USER.Email</div>
                                <div class="text-muted small">@item.USER.Phone</div>
                            </td>
                            <td>@item.AppliedDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.CANDIDATEPROFILE != null && !string.IsNullOrEmpty(item.CANDIDATEPROFILE.CV_Url))
                                {
                                    <a href="@Url.Content(item.CANDIDATEPROFILE.CV_Url)" target="_blank" class="btn btn-sm btn-info text-white me-1">Xem CV (PDF)</a>
                                }
                                else
                                {
                                    <span class="text-muted small me-1">Chưa có CV</span>
                                }

                                @if (!string.IsNullOrEmpty(item.CoverLetter))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            data-letter="@item.CoverLetter"
                                            onclick="alert(this.getAttribute('data-letter'))">
                                        Xem thư
                                    </button>
                                }
                            </td>
                            <td class="text-center">
                                @switch (item.Status)
                                {
                                    case "Pending":
                                    case "Submitted":
                                        <span class="badge bg-secondary">Chờ duyệt</span>
                                        break;
                                    case "Reviewed":
                                        <span class="badge bg-info text-dark">Đang xem xét</span>
                                        break;
                                    case "Interview":
                                        <span class="badge bg-primary">Phỏng vấn</span>
                                        break;
                                    case "Accepted":
                                    case "Approved":
                                        <span class="badge bg-success">Đã nhận</span>
                                        break;
                                    case "Rejected":
                                        <span class="badge bg-danger">Đã từ chối</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@item.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Status == "Pending" || item.Status == "Submitted")
                                {
                                    using (Html.BeginForm("UpdateStatus", "Applications", FormMethod.Post, new { style = "display:inline-block;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                        <input type="hidden" name="newStatus" value="Reviewed" />
                                        <button type="submit" class="btn btn-sm btn-info text-white me-1">Xem xét</button>
                                    }
                                    using (Html.BeginForm("UpdateStatus", "Applications", FormMethod.Post, new { style = "display:inline-block;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                        <input type="hidden" name="newStatus" value="Rejected" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Từ chối</button>
                                    }
                                }
                                else if (item.Status == "Reviewed")
                                {
                                    using (Html.BeginForm("UpdateStatus", "Applications", FormMethod.Post, new { style = "display:inline-block;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                        <input type="hidden" name="newStatus" value="Interview" />
                                        <button type="submit" class="btn btn-sm btn-primary me-1">Mời phỏng vấn</button>
                                    }
                                    using (Html.BeginForm("UpdateStatus", "Applications", FormMethod.Post, new { style = "display:inline-block;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                        <input type="hidden" name="newStatus" value="Rejected" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Từ chối</button>
                                    }
                                }
                                else if (item.Status == "Interview")
                                {
                                    using (Html.BeginForm("UpdateStatus", "Applications", FormMethod.Post, new { style = "display:inline-block;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                        <input type="hidden" name="newStatus" value="Accepted" />
                                        <button type="submit" class="btn btn-sm btn-success me-1">Nhận việc</button>
                                    }
                                    using (Html.BeginForm("UpdateStatus", "Applications", FormMethod.Post, new { style = "display:inline-block;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                        <input type="hidden" name="newStatus" value="Rejected" />
                                        <button type="submit" class="btn btn-sm btn-danger">Từ chối</button>
                                    }
                                }
                                else
                                {
                                    using (Html.BeginForm("UpdateStatus", "Applications", FormMethod.Post, new { style = "display:inline-block;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                        <input type="hidden" name="newStatus" value="Reviewed" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Đưa hồ sơ quay lại bước Đang xem xét">
                                            <i class="bi bi-arrow-counterclockwise"></i> Xem xét lại
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>