@using Job_Recruitment_Website.Models
@{
    // ===== LẤY DỮ LIỆU CHO MENU / ASIDE / FOOTER (MỞ VÀ ĐÓNG KẾT NỐI DB NGAY TẠI ĐÂY) =====
    int totalOpenJobs = 0;
    int countHN = 0;
    int countHCM = 0;
    int countDN = 0;
    int myAppCount = 0;
    var categories = new List<KeyValuePair<CATEGORy, int>>();
    var locations = new List<KeyValuePair<string, int>>();

    using (var db = new RecruitmentDBEntities())
    {
        var openJobsList = db.JOBS.Where(j => j.Status == "Open").Select(j => j.Location).ToList();
        totalOpenJobs = openJobsList.Count;

        // 1. Danh mục Ngành nghề kèm số việc làm đang mở
        var catData = db.CATEGORIES
                        .Select(c => new { Cat = c, Count = c.JOBS.Count(j => j.Status == "Open") })
                        .OrderByDescending(x => x.Count)
                        .ThenBy(x => x.Cat.CategoryName)
                        .ToList();
        foreach (var item in catData)
        {
            categories.Add(new KeyValuePair<CATEGORy, int>(item.Cat, item.Count));
        }

        // 2. Danh sách Địa điểm tự động tổng hợp từ các việc làm + các thành phố lớn tiêu biểu
        string[] standardCities = { "TP. Hồ Chí Minh", "Hà Nội", "Đà Nẵng", "Bình Dương", "Cần Thơ", "Hải Phòng" };
        var cityCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var city in standardCities)
        {
            cityCounts[city] = 0;
        }

        foreach (var rawLoc in openJobsList)
        {
            if (string.IsNullOrWhiteSpace(rawLoc))
            {
                continue;
            }
            string loc = rawLoc.Trim();

            if (loc.IndexOf("Hồ Chí Minh", StringComparison.OrdinalIgnoreCase) >= 0 || loc.IndexOf("TP.HCM", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                cityCounts["TP. Hồ Chí Minh"]++;
            }
            else if (loc.IndexOf("Hà Nội", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                cityCounts["Hà Nội"]++;
            }
            else if (loc.IndexOf("Đà Nẵng", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                cityCounts["Đà Nẵng"]++;
            }
            else
            {
                // Nếu Nhà tuyển dụng đăng tỉnh mới (VD: Đồng Nai, Nha Trang, Bắc Ninh...) thì tự động thêm vào menu!
                var matchedKey = cityCounts.Keys.FirstOrDefault(k => loc.IndexOf(k, StringComparison.OrdinalIgnoreCase) >= 0);
                if (matchedKey != null)
                {
                    cityCounts[matchedKey]++;
                }
                else
                {
                    cityCounts[loc] = cityCounts.ContainsKey(loc) ? cityCounts[loc] + 1 : 1;
                }
            }
        }

        countHCM = cityCounts["TP. Hồ Chí Minh"];
        countHN = cityCounts["Hà Nội"];
        countDN = cityCounts["Đà Nẵng"];

        locations = cityCounts.OrderByDescending(kv => kv.Value)
                              .ThenBy(kv => kv.Key)
                              .ToList();

        if (Session["UserId"] != null)
        {
            int uid = (int)Session["UserId"];
            myAppCount = db.APPLICATIONS.Count(a => a.UserId == uid);
        }
    }

    // ===== VAI TRÒ NGƯỜI DÙNG =====
    string currentRole = Session["Role"] != null ? Session["Role"].ToString() : "";
    bool isLoggedIn = Session["UserId"] != null;
    bool isRecruiter = currentRole == "Recruiter";
    bool isAdmin = currentRole == "Admin";
    string roleDisplay = isRecruiter ? "Employer" : currentRole;

    string currentController = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    string currentAction = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";

    int? selectedCat = null;
    int parsedCat;
    if (!string.IsNullOrEmpty(Request.QueryString["categoryId"]) && int.TryParse(Request.QueryString["categoryId"], out parsedCat))
    {
        selectedCat = parsedCat;
    }

    string selectedLoc = Request.QueryString["location"];
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - D-JOBS Recruitment Agency</title>

    <!-- 1. BOOTSTRAP 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- BOOTSTRAP ICONS CHO FOOTER VÀ GIAO DIỆN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- 2. FILE CSS CHÍNH -->
    <link href="@Url.Content("~/Content/StyleLayoutRecruitment.css?v=103")" rel="stylesheet" />
</head>
<body>

    <!-- HEADER -->
    <header class="py-2 sticky-top">
        <div class="container d-flex align-items-center justify-content-between">

            <!-- LOGO D-JOBS -->
            <div class="logo">
                <a href="@Url.Action("Index", "Jobs")">
                    <img src="@Url.Content("~/Content/Images/logo.png")" alt="D-Jobs Recruitment Agency" />
                </a>
            </div>

            <!-- MENU -->
            <nav>
                <ul class="nav gap-4 mb-0">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Jobs" && currentAction == "Index" ? "active-menu" : "")" href="@Url.Action("Index", "Jobs")">Việc làm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController.Equals("Companies", StringComparison.OrdinalIgnoreCase) ? "active-menu" : "")" href="@Url.Action("Index", "Companies")">Công ty</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController.Equals("Categories", StringComparison.OrdinalIgnoreCase) ? "active-menu" : "")" href="@Url.Action("Index", "CATEGORies")">Ngành nghề</a>
                    </li>

                    <!-- HỒ SƠ (CÓ RETURN URL KHI CHƯA ĐĂNG NHẬP) -->
                    <li class="nav-item">
                        @if (!isLoggedIn)
                        {
                            <a class="nav-link" href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Profile", "Account") })">Hồ sơ ứng viên</a>
                        }
                        else
                        {
                            <a class="nav-link @(currentController == "Account" && currentAction == "Profile" ? "active-menu" : "")" href="@Url.Action("Profile", "Account")">
                                @(isRecruiter || isAdmin ? "Hồ sơ cá nhân" : "Hồ sơ ứng viên")
                            </a>
                        }
                    </li>

                    <!-- ĐƠN ỨNG TUYỂN: CHỈ HIỆN CHO KHÁCH VÀ ỨNG VIÊN -->
                    @if (!isRecruiter && !isAdmin)
                    {
                        <li class="nav-item">
                            @if (!isLoggedIn)
                            {
                                <a class="nav-link" href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("MyApplications", "Applications") })">Đơn ứng tuyển</a>
                            }
                            else
                            {
                                <a class="nav-link @(currentController == "Applications" ? "active-menu" : "")" href="@Url.Action("MyApplications", "Applications")">Đơn ứng tuyển</a>
                            }
                        </li>
                    }

                    @if (isRecruiter)
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-bold @(currentController == "Jobs" && currentAction != "Index" && currentAction != "Details" ? "active-menu" : "")"
                               style="color: var(--accent-lime) !important;" href="@Url.Action("MyJobs", "Jobs")">Quản lý tin đăng</a>
                        </li>
                    }
                    else if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-warning @(currentController == "Admin" ? "active-menu" : "")" href="@Url.Action("Index", "Admin")">Quản trị Admin</a>
                        </li>
                    }
                </ul>
            </nav>

            <!-- LOGIN / REGISTER -->
            <div class="auth-buttons d-flex align-items-center gap-3">
                @if (isLoggedIn)
                {
                    <span class="text-dark small fw-semibold">
                        Xin chào, <strong>@Session["FullName"]</strong> (@roleDisplay)
                    </span>
                    <a class="btn btn-primary-custom px-3 py-2" href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                }
                else
                {
                    <a class="btn-login-soft" href="@Url.Action("Login", "Account")">Đăng nhập</a>
                    <a class="btn btn-primary-custom px-3 py-2" href="@Url.Action("Register", "Account")">Đăng ký</a>
                }
            </div>

        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="container my-4 flex-grow-1">

        <!-- BANNER NẰM TRÊN HẲN (VẮT NGANG TOÀN BỘ TRANG) -->
        <div class="banner-container mb-4">
            <img src="@Url.Content("~/Content/Images/banner.jpg")" alt="Banner Tuyển Dụng" class="banner-img" />
        </div>

        <div class="job-content">
            <!-- CỘT ASIDE BÊN TRÁI (PHÂN TRANG KIỂU TOPCV: 5 MỤC / TRANG) -->
            <aside class="job-filter">

                <!-- 1. NHÓM NGÀNH NGHỀ (PHÂN TRANG 5 MỤC) -->
                <div class="filter-group" data-aside-pager="categories" data-page-size="5">
                    <h4>NGÀNH NGHỀ</h4>
                    <a href="@Url.Action("Index", "Jobs", new { location = selectedLoc })" class="aside-item @(selectedCat == null ? "active" : "")">
                        <span>Tất cả</span>
                        <span class="aside-count">@totalOpenJobs</span>
                    </a>
                    <div class="aside-paged-list">
                        @foreach (var cat in categories)
                        {
                            <a href="@Url.Action("Index", "Jobs", new { categoryId = cat.Key.CategoryId, location = selectedLoc })"
                               class="aside-item aside-paged-item @(selectedCat == cat.Key.CategoryId ? "active" : "")">
                                <span class="text-truncate pe-2">@cat.Key.CategoryName</span>
                                <span class="aside-count">@cat.Value</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- 2. NHÓM ĐỊA ĐIỂM (PHÂN TRANG 5 MỤC) -->
                <div class="filter-group" data-aside-pager="locations" data-page-size="5">
                    <h4>ĐỊA ĐIỂM</h4>
                    <a href="@Url.Action("Index", "Jobs", new { categoryId = selectedCat })" class="aside-item @(string.IsNullOrEmpty(selectedLoc) ? "active" : "")">
                        <span>Tất cả</span>
                        <span class="aside-count">@totalOpenJobs</span>
                    </a>
                    <div class="aside-paged-list">
                        @foreach (var loc in locations)
                        {
                            string locParam = loc.Key == "TP. Hồ Chí Minh" ? "Hồ Chí Minh" : loc.Key;
                            bool isLocActive = !string.IsNullOrEmpty(selectedLoc) &&
                                               (selectedLoc.Equals(locParam, StringComparison.OrdinalIgnoreCase) ||
                                                selectedLoc.Equals(loc.Key, StringComparison.OrdinalIgnoreCase));

                            <a href="@Url.Action("Index", "Jobs", new { location = locParam, categoryId = selectedCat })"
                               class="aside-item aside-paged-item @(isLocActive ? "active" : "")">
                                <span class="text-truncate pe-2">@loc.Key</span>
                                <span class="aside-count">@loc.Value</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- 3. NHÓM LỐI TẮT -->
                <div class="filter-group">
                    <h4>LỐI TẮT</h4>
                    @if (!isLoggedIn)
                    {
                        <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Profile", "Account") })" class="aside-item">
                            <span>Hồ sơ của tôi</span>
                        </a>
                        <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("MyApplications", "Applications") })" class="aside-item">
                            <span>Đơn ứng tuyển</span>
                            <span class="aside-count">0</span>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Profile", "Account")" class="aside-item @(currentController == "Account" && currentAction == "Profile" ? "active" : "")">
                            <span>Hồ sơ của tôi</span>
                        </a>

                        if (isRecruiter)
                        {
                            <a href="@Url.Action("MyJobs", "Jobs")" class="aside-item @(currentController == "Jobs" && currentAction == "MyJobs" ? "active" : "")">
                                <span>Quản lý tin đăng</span>
                            </a>
                            <a href="@Url.Action("MyCompany", "Companies")" class="aside-item @(currentController.Equals("Companies", StringComparison.OrdinalIgnoreCase) && currentAction == "MyCompany" ? "active" : "")">
                                <span>Công ty của tôi</span>
                            </a>
                        }
                        else if (isAdmin)
                        {
                            <a href="@Url.Action("Index", "Admin")" class="aside-item @(currentController == "Admin" ? "active" : "")">
                                <span>Quản trị hệ thống</span>
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("MyApplications", "Applications")" class="aside-item @(currentController == "Applications" && currentAction == "MyApplications" ? "active" : "")">
                                <span>Đơn ứng tuyển</span>
                                <span class="aside-count">@myAppCount</span>
                            </a>
                        }
                    }
                </div>
            </aside>

            <!-- CỘT NỘI DUNG BÊN PHẢI -->
            <div class="job-list-container">
                @RenderBody()
            </div>
        </div>
    </main>

    <!-- FOOTER 4 CỘT -->
    <footer class="border-top pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row gy-4">

                <!-- CỘT 1: THÔNG TIN THƯƠNG HIỆU -->
                <div class="col-lg-4 col-md-6 pe-lg-4">
                    <h5 class="fw-bold mb-3 text-orange">D-JOBS Recruitment Agency</h5>
                    <p class="small mb-3" style="line-height: 1.6;">
                        Nền tảng kết nối nhân tài với hàng ngàn cơ hội nghề nghiệp hấp dẫn từ các doanh nghiệp hàng đầu. Đồng hành cùng sự nghiệp của bạn.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>
                        <a href="#" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="YouTube">
                            <i class="bi bi-youtube"></i>
                        </a>
                        <a href="mailto:support@d-jobs.vn" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Email">
                            <i class="bi bi-envelope-fill"></i>
                        </a>
                    </div>
                </div>

                <!-- CỘT 2: DÀNH CHO ỨNG VIÊN -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-uppercase small">Dành cho ứng viên</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a href="@Url.Action("Index", "Jobs")" class="footer-link">Tìm việc làm</a></li>
                        <li><a href="@Url.Action("Index", "Companies")" class="footer-link">Danh sách công ty</a></li>
                        <li>
                            @if (!isLoggedIn)
                            {
                                <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Profile", "Account") })" class="footer-link">Hồ sơ cá nhân</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Profile", "Account")" class="footer-link">Hồ sơ cá nhân</a>
                            }
                        </li>
                        <li>
                            @if (!isLoggedIn)
                            {
                                <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("MyApplications", "Applications") })" class="footer-link">Việc đã ứng tuyển</a>
                            }
                            else
                            {
                                <a href="@Url.Action("MyApplications", "Applications")" class="footer-link">Việc đã ứng tuyển</a>
                            }
                        </li>
                    </ul>
                </div>

                <!-- CỘT 3: KHÁM PHÁ VIỆC LÀM -->
                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="text-uppercase small">Khám phá việc làm</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a href="@Url.Action("Index", "CATEGORies")" class="footer-link">Tất cả ngành nghề</a></li>
                        <li>
                            <a href="@Url.Action("Index", "Jobs", new { location = "Hồ Chí Minh" })" class="footer-link d-flex justify-content-between align-items-center">
                                <span>Việc làm TP.HCM</span>
                                <span class="badge bg-light text-secondary border">@countHCM</span>
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "Jobs", new { location = "Hà Nội" })" class="footer-link d-flex justify-content-between align-items-center">
                                <span>Việc làm Hà Nội</span>
                                <span class="badge bg-light text-secondary border">@countHN</span>
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "Jobs", new { location = "Đà Nẵng" })" class="footer-link d-flex justify-content-between align-items-center">
                                <span>Việc làm Đà Nẵng</span>
                                <span class="badge bg-light text-secondary border">@countDN</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- CỘT 4: LIÊN HỆ -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase small">Liên hệ</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0 text-secondary">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt-fill mt-1" style="color: var(--primary-orange);"></i>
                            <span>Quận 1, Thành phố Hồ Chí Minh</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone-fill" style="color: var(--primary-orange);"></i>
                            <span>(028) 3888 9999</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-fill" style="color: var(--primary-orange);"></i>
                            <span>support@d-jobs.vn</span>
                        </li>
                    </ul>
                </div>

            </div>

            <hr class="my-4 border-secondary-subtle" />

            <!-- BẢN QUYỀN DƯỚI CÙNG -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted gap-2">
                <p class="mb-0">© @DateTime.Now.Year <strong>D-JOBS Recruitment Agency</strong>. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-muted text-decoration-none footer-link">Điều khoản dịch vụ</a>
                    <span>•</span>
                    <a href="#" class="text-muted text-decoration-none footer-link">Chính sách bảo mật</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/recruitment.js?v=103")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>