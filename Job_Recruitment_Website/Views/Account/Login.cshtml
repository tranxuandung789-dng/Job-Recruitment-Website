@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">

            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Đăng nhập</h3>
                <p class="text-muted small">Chào mừng bạn quay trở lại với D-JOBS</p>
            </div>

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
                }

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Email</label>
                    <input type="email" name="email" class="form-control rounded-3 py-2" placeholder="name@example.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Mật khẩu</label>
                    <input type="password" name="password" class="form-control rounded-3 py-2" placeholder="••••••••" required />
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary-custom text-white fw-bold py-2 rounded-3">Đăng nhập</button>
                </div>
            }

            <div class="text-center mt-4">
                <span class="text-muted small">Chưa có tài khoản?</span>
                <a href="@Url.Action("Register", "Account")" class="text-decoration-none fw-bold text-orange">Đăng ký ngay</a>
            </div>

        </div>
    </div>
</div>