@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white" style="max-width: 440px; margin: 0 auto; border: 1px solid #fff3e0 !important;">

            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Đăng nhập</h3>
                <p class="text-muted small">Chào mừng bạn quay trở lại với D-JOBS</p>
            </div>

            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { novalidate = "novalidate", id = "loginForm" }))
            {
                @Html.AntiForgeryToken()

                <!-- LƯU GIỮ ĐƯỜNG DẪN TRƯỚC ĐÓ ĐỂ TỰ ĐỘNG QUAY LẠI SAU KHI ĐĂNG NHẬP -->
                <input type="hidden" name="returnUrl" value="@(ViewBag.ReturnUrl ?? Request.QueryString["returnUrl"])" />

                if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 small rounded-3 text-center fw-semibold">@ViewBag.Error</div>
                }

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Email</label>
                    <input type="email" id="email" name="email" class="form-control rounded-3 py-2" placeholder="name@example.com" />
                    <div class="invalid-feedback" id="err-Email">
                        Vui lòng nhập địa chỉ email.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Mật khẩu</label>
                    <input type="password" id="password" name="password" class="form-control rounded-3 py-2" placeholder="••••••••" />
                    <div class="invalid-feedback" id="err-Password">
                        Vui lòng nhập mật khẩu.
                    </div>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn text-white fw-bold py-2 rounded-3 shadow-sm" style="background-color: #f7931e; border: none;">
                        Đăng nhập
                    </button>
                </div>
            }

            <div class="text-center mt-4">
                <span class="text-muted small">Chưa có tài khoản?</span>
                <a href="@Url.Action("Register", "Account")" class="text-decoration-none fw-bold" style="color: #f7931e;">Đăng ký ngay</a>
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var form = document.getElementById('loginForm');
            if (!form) return;

            var email = document.getElementById('email');
            var password = document.getElementById('password');

            var emailRe = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            function setInvalid(input, errId, isInvalid, msg) {
                if (!input) return;
                var errEl = document.getElementById(errId);
                if (errEl && msg) {
                    errEl.textContent = msg;
                }
                input.classList.toggle('is-invalid', isInvalid);
            }

            function checkEmail(forceEmptyCheck) {
                var v = email.value.trim();
                if (v.length === 0) {
                    setInvalid(email, 'err-Email', forceEmptyCheck, 'Vui lòng nhập địa chỉ email.');
                    return false;
                }
                var ok = emailRe.test(v);
                setInvalid(email, 'err-Email', !ok, 'Email không đúng định dạng (ví dụ: name@example.com).');
                return ok;
            }

            function checkPassword(forceEmptyCheck) {
                var v = password.value;
                if (v.length === 0) {
                    setInvalid(password, 'err-Password', forceEmptyCheck, 'Vui lòng nhập mật khẩu.');
                    return false;
                }
                setInvalid(password, 'err-Password', false);
                return true;
            }

            // Gắn sự kiện khi gõ và khi rời chuột khỏi ô
            email.addEventListener('input', function () { checkEmail(false); });
            email.addEventListener('blur', function () { checkEmail(true); });

            password.addEventListener('input', function () { checkPassword(false); });
            password.addEventListener('blur', function () { checkPassword(true); });

            // Kiểm tra tất cả các ô khi bấm nút "Đăng nhập"
            form.addEventListener('submit', function (e) {
                var validEmail = checkEmail(true);
                var validPass = checkPassword(true);

                if (!validEmail || !validPass) {
                    e.preventDefault();
                    var firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) firstInvalid.focus();
                }
            });
        })();
    </script>
}