@model Job_Recruitment_Website.Models.USER

@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">

            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Đăng ký tài khoản</h3>
                <p class="text-muted small">Tạo tài khoản để kết nối cơ hội nghề nghiệp cùng D-JOBS</p>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Họ và tên</label>
                    @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-control rounded-3 py-2", required = "required", placeholder = "Nguyễn Văn A" } })
                    @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Email</label>
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control rounded-3 py-2", type = "email", required = "required", placeholder = "name@example.com" } })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Số điện thoại</label>
                    @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control rounded-3 py-2", type = "tel", required = "required", placeholder = "Nhập 10-11 số" } })
                    @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Mật khẩu</label>
                    <input type="password" name="password" class="form-control rounded-3 py-2" required="required" placeholder="••••••••" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Nhập lại mật khẩu</label>
                    <input type="password" name="confirmPassword" class="form-control rounded-3 py-2" required="required" placeholder="••••••••" />
                    @Html.ValidationMessage("PasswordError", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small text-secondary">Vai trò</label>
                    <select name="role" class="form-select rounded-3 py-2">
                        <option value="Candidate">Ứng viên (Candidate)</option>
                        <option value="Recruiter">Nhà tuyển dụng (Employer)</option>
                    </select>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary-custom text-white fw-bold py-2 rounded-3">Đăng ký ngay</button>
                </div>
            }

            <div class="text-center mt-2">
                <span class="text-muted small">Đã có tài khoản?</span>
                <a href="@Url.Action("Login", "Account")" class="text-decoration-none fw-bold text-orange">Đăng nhập</a>
            </div>

        </div>
    </div>
</div>