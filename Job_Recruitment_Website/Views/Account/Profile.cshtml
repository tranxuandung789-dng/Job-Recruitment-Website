@model Job_Recruitment_Website.Models.USER
@using Job_Recruitment_Website.Models

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";

    string roleName = Model != null && Model.ROLE != null
        ? Model.ROLE.RoleName
        : (Session["Role"] != null ? Session["Role"].ToString() : "Candidate");

    bool isRecruiter = roleName == "Recruiter";
    bool isAdmin = roleName == "Admin";
    bool isCandidate = !isRecruiter && !isAdmin;

    string roleDisplay = isRecruiter ? "Employer" : roleName;

    string fullName = Model != null && Model.FullName != null ? Model.FullName.Trim() : "";
    string avatarLetter = fullName.Length > 0 ? fullName.Substring(0, 1).ToUpper() : "U";

    var candidateProfile = ViewBag.CandidateProfile as CANDIDATEPROFILE;

    string emailError = ViewBag.EmailError as string;
    string emailValue = (ViewBag.EmailValue as string) ?? (Model != null ? Model.Email : "");

    string phoneError = ViewBag.PhoneError as string;
    string phoneValue = (ViewBag.PhoneValue as string) ?? (Model != null ? Model.Phone : "");
}

<!-- TIÊU ĐỀ TRANG -->
<div class="job-section-header mb-3">
    <h2 class="fw-bold text-dark mb-1">@(isCandidate ? "Hồ sơ ứng viên" : "Hồ sơ cá nhân")</h2>
    <p class="text-muted small mb-0">
        @(isCandidate
            ? "Quản lý thông tin tài khoản và hồ sơ năng lực (Profile & CV) tại D-JOBS"
            : "Quản lý thông tin liên hệ và tài khoản quản trị trên hệ thống D-JOBS")
    </p>
</div>

<!-- THÔNG BÁO CẬP NHẬT THÀNH CÔNG / LỖI TỪ SERVER -->
@if (ViewBag.Success != null)
{
    <div class="alert alert-success rounded-3 py-2 small fw-semibold mb-3">
        ✔ @ViewBag.Success
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger rounded-3 py-2 small fw-semibold mb-3">
        ⚠ @ViewBag.Error
    </div>
}

<!-- KHUNG HỒ SƠ CÁ NHÂN -->
<div class="profile-main-card mb-4">
    <!-- HEADER AVATAR & TÓM TẮT TÀI KHOẢN -->
    <div class="profile-hero">
        <div class="profile-hero-left">
            <div class="profile-avatar-circle">
                @avatarLetter
            </div>
            <div>
                <div class="profile-hero-name">@(fullName.Length > 0 ? fullName : "Người dùng")</div>
                <div class="profile-hero-badges">
                    <span class="profile-role-badge">
                        <i class="bi @(isAdmin ? "bi-shield-lock-fill" : (isRecruiter ? "bi-building" : "bi-person-badge-fill"))"></i>
                        @roleDisplay
                    </span>
                    <span class="profile-meta-chip">
                        <i class="bi bi-hash text-orange"></i> Mã TK: @(Model != null ? Model.UserId : 0)
                    </span>
                    <span class="profile-meta-chip">
                        <i class="bi bi-check-circle-fill text-success"></i> Đang hoạt động
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- NỘI DUNG FORM -->
    <div class="profile-body">
        @using (Html.BeginForm("Profile", "Account", FormMethod.Post, new { enctype = "multipart/form-data", id = "profileForm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()

            <h6 class="profile-section-heading">1. Thông tin tài khoản</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="job-label" for="FullName">
                        <i class="bi bi-person-vcard-fill"></i>
                        <span>Họ và tên <span class="text-danger">*</span></span>
                    </label>
                    <input type="text" id="FullName" name="FullName"
                           class="form-control job-input"
                           value="@(Model != null ? Model.FullName : "")"
                           placeholder="Nhập họ và tên..." maxlength="150" />
                    <div id="FullNameError" class="invalid-feedback">
                        Vui lòng nhập họ và tên.
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="job-label" for="Phone">
                        <i class="bi bi-telephone-fill"></i>
                        <span>Số điện thoại <span class="text-danger">*</span></span>
                    </label>
                    <input type="tel" id="Phone" name="Phone"
                           class="form-control job-input @(phoneError != null ? "is-invalid" : "")"
                           value="@phoneValue"
                           placeholder="Nhập 10-11 chữ số..."
                           inputmode="numeric" maxlength="11" />
                    <div id="PhoneError" class="invalid-feedback">
                        @(phoneError ?? "Số điện thoại phải gồm 10 hoặc 11 chữ số.")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="job-label" for="Email">
                        <i class="bi bi-envelope-at-fill"></i>
                        <span>Email đăng nhập <span class="text-danger">*</span></span>
                    </label>
                    <input type="email" id="Email" name="Email"
                           class="form-control job-input @(emailError != null ? "is-invalid" : "")"
                           value="@emailValue"
                           placeholder="name@example.com" maxlength="150" />
                    <div id="EmailError" class="invalid-feedback">
                        @(emailError ?? "Vui lòng nhập địa chỉ email hợp lệ.")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="job-label">
                        <i class="bi bi-calendar-check-fill"></i>
                        <span>Ngày tham gia hệ thống</span>
                    </label>
                    <input type="text" class="form-control job-input profile-readonly-input"
                           value="@(Model != null ? string.Format("{0:dd/MM/yyyy}", Model.CreatedAt) : "Đang cập nhật")" readonly />
                </div>
            </div>

            if (isCandidate)
            {
                <hr class="my-4 text-secondary opacity-25" />
                <h6 class="profile-section-heading">2. Hồ sơ năng lực & CV ứng viên</h6>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="job-label">
                            <i class="bi bi-mortarboard-fill"></i>
                            <span>Trình độ học vấn (Education)</span>
                        </label>
                        <input type="text" name="Education" class="form-control job-input"
                               value="@(candidateProfile != null ? candidateProfile.Education : "")"
                               placeholder="VD: Cử nhân CNTT - ĐH Bách Khoa..." maxlength="255" />
                    </div>

                    <div class="col-md-6">
                        <label class="job-label">
                            <i class="bi bi-briefcase-fill"></i>
                            <span>Kinh nghiệm làm việc (Experience)</span>
                        </label>
                        <input type="text" name="Experience" class="form-control job-input"
                               value="@(candidateProfile != null ? candidateProfile.Experience : "")"
                               placeholder="VD: 2 năm kinh nghiệm lập trình Web..." maxlength="255" />
                    </div>

                    <div class="col-12">
                        <label class="job-label">
                            <i class="bi bi-stars"></i>
                            <span>Kỹ năng chuyên môn (Skills)</span>
                        </label>
                        <input type="text" name="Skills" class="form-control job-input"
                               value="@(candidateProfile != null ? candidateProfile.Skills : "")"
                               placeholder="VD: C#, ASP.NET MVC, SQL Server, ReactJS..." maxlength="255" />
                    </div>

                    <div class="col-12">
                        <label class="job-label">
                            <i class="bi bi-file-earmark-pdf-fill"></i>
                            <span>Cập nhật CV đính kèm (Chỉ nhận PDF chuẩn, tối đa 5MB)</span>
                        </label>
                        <input type="file" name="cvFile" class="form-control job-input" accept=".pdf" />

                        @if (candidateProfile != null && !string.IsNullOrEmpty(candidateProfile.CV_Url) && candidateProfile.CV_Url != "Đang cập nhật")
                        {
                            <div class="profile-cv-box">
                                <div class="d-flex align-items-center gap-2 small">
                                    <i class="bi bi-file-earmark-check-fill text-orange fs-5"></i>
                                    <span class="text-dark fw-semibold">
                                        Đã lưu hồ sơ CV (Cập nhật ngày: @candidateProfile.UpdatedAt.ToString("dd/MM/yyyy"))
                                    </span>
                                </div>
                                <a href="@Url.Action("MyCv", "Account")" target="_blank" class="btn-view-cv-soft">
                                    <i class="bi bi-eye-fill"></i>
                                    <span>Xem file CV đã lưu</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- THANH NÚT THAO TÁC DƯỚI CÙNG -->
            <div class="profile-footer-bar">
                <button type="submit" class="btn-submit-job d-inline-flex align-items-center gap-2">
                    <i class="bi bi-check2-circle"></i>
                    <span>Lưu thay đổi</span>
                </button>

                <div class="d-flex flex-wrap gap-2">
                    @if (isRecruiter)
                    {
                        <a href="@Url.Action("MyJobs", "Jobs")" class="btn-profile-nav">
                            <i class="bi bi-briefcase"></i> Quản lý tin đăng
                        </a>
                        <a href="@Url.Action("MyCompany", "Companies")" class="btn-profile-nav">
                            <i class="bi bi-building"></i> Công ty của tôi
                        </a>
                    }
                    else if (isAdmin)
                    {
                        <a href="@Url.Action("Index", "Admin")" class="btn-profile-nav">
                            <i class="bi bi-speedometer2"></i> Quản trị hệ thống
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("MyApplications", "Applications")" class="btn-profile-nav">
                            <i class="bi bi-send-check"></i> Xem đơn ứng tuyển
                        </a>
                        <a href="@Url.Action("Index", "Jobs")" class="btn-profile-nav">
                            <i class="bi bi-search"></i> Tìm việc làm
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var form = document.getElementById('profileForm');
            if (!form) return;

            var fullName = document.getElementById('FullName');
            var email = document.getElementById('Email');
            var phone = document.getElementById('Phone');

            var nameErr = document.getElementById('FullNameError');
            var emailErr = document.getElementById('EmailError');
            var phoneErr = document.getElementById('PhoneError');

            var emailRe = /^[^\s@@]+@@[^\s@@]{2,}\.[^\s@@]{2,}$/;
            var phoneRe = /^[0-9]{10,11}$/;

            function checkName(forceEmptyCheck) {
                var v = fullName.value.trim();
                if (v.length === 0) {
                    fullName.classList.toggle('is-invalid', forceEmptyCheck);
                    if (nameErr) nameErr.textContent = 'Vui lòng nhập họ và tên.';
                    return false;
                }
                fullName.classList.remove('is-invalid');
                return true;
            }

            function checkEmail(forceEmptyCheck) {
                var v = email.value.trim();
                if (v.length === 0) {
                    email.classList.toggle('is-invalid', forceEmptyCheck);
                    if (emailErr) emailErr.textContent = 'Vui lòng nhập địa chỉ email.';
                    return false;
                }
                if (!emailRe.test(v)) {
                    email.classList.add('is-invalid');
                    if (emailErr) emailErr.textContent = 'Email không đúng định dạng (ví dụ: name@example.com).';
                    return false;
                }
                email.classList.remove('is-invalid');
                return true;
            }

            function checkPhone(forceEmptyCheck) {
                var v = phone.value.trim();
                if (v.length === 0) {
                    phone.classList.toggle('is-invalid', forceEmptyCheck);
                    if (phoneErr) phoneErr.textContent = 'Vui lòng nhập số điện thoại.';
                    return false;
                }
                if (!phoneRe.test(v)) {
                    phone.classList.add('is-invalid');
                    if (phoneErr) phoneErr.textContent = 'Số điện thoại không hợp lệ! Chỉ nhập 10 hoặc 11 chữ số.';
                    return false;
                }
                phone.classList.remove('is-invalid');
                return true;
            }

            fullName.addEventListener('input', function () { checkName(false); });
            fullName.addEventListener('blur', function () { checkName(true); });

            email.addEventListener('input', function () { checkEmail(false); });
            email.addEventListener('blur', function () { checkEmail(true); });

            phone.addEventListener('input', function () { checkPhone(false); });
            phone.addEventListener('blur', function () { checkPhone(true); });

            form.addEventListener('submit', function (e) {
                var okName = checkName(true);
                var okEmail = checkEmail(true);
                var okPhone = checkPhone(true);

                if (!okName || !okEmail || !okPhone) {
                    e.preventDefault();
                    var firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) firstInvalid.focus();
                }
            });
        })();
    </script>
}