@model Job_Recruitment_Website.Models.USER

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";

    // ===== XÁC ĐỊNH VAI TRÒ =====
    string roleName = Model != null && Model.ROLE != null
        ? Model.ROLE.RoleName
        : (Session["Role"] != null ? Session["Role"].ToString() : "Candidate");

    bool isRecruiter = roleName == "Recruiter";
    bool isAdmin = roleName == "Admin";

    // Chỉ đổi CHỮ HIỂN THỊ, giá trị phân quyền vẫn là "Recruiter"
    string roleDisplay = isRecruiter ? "Employer" : roleName;

    // ===== CHỮ CÁI ĐẦU LÀM AVATAR (AN TOÀN KHI TÊN RỖNG) =====
    string fullName = Model != null && Model.FullName != null ? Model.FullName.Trim() : "";
    string avatarLetter = fullName.Length > 0 ? fullName.Substring(0, 1).ToUpper() : "U";
}

<!-- TIÊU ĐỀ TRANG -->
<div class="job-section-header mb-4">
    <h2 class="fw-bold text-dark mb-1">Hồ sơ cá nhân</h2>
    <p class="text-muted small mb-0">Quản lý và cập nhật thông tin tài khoản của bạn tại D-JOBS.</p>
</div>

<!-- KHUNG THÔNG TIN HỒ SƠ -->
<div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white mb-4" style="max-width: 720px; border: 1px solid #f1f5f9 !important;">

    <!-- Avatar / Tóm tắt nhanh -->
    <div class="d-flex align-items-center gap-3 pb-4 mb-4 border-bottom">
        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
             style="width: 64px; height: 64px; background-color: #f7931e; font-size: 24px; flex-shrink: 0;">
            @avatarLetter
        </div>
        <div>
            <h4 class="fw-bold text-dark mb-1">@(fullName.Length > 0 ? fullName : "Người dùng")</h4>
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill px-3 py-1 fw-semibold" style="background-color: #fff3e0; color: #f7931e;">
                    @roleDisplay
                </span>
                <span class="text-muted small">• Mã TK: #@(Model != null ? Model.UserId : 0)</span>
            </div>
        </div>
    </div>

    <!-- Thông báo Cập nhật thành công / lỗi -->
    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success rounded-3 py-2 small fw-semibold">
            ✔ @ViewBag.Success
        </div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger rounded-3 py-2 small fw-semibold">
            ⚠ @ViewBag.Error
        </div>
    }

    <!-- FORM CẬP NHẬT HỒ SƠ -->
    @using (Html.BeginForm("Profile", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold small text-secondary">Họ và tên <span class="text-danger">*</span></label>
                <input type="text" name="FullName" class="form-control rounded-3 py-2"
                       value="@(Model != null ? Model.FullName : "")"
                       placeholder="Nhập họ và tên..." maxlength="150" required />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold small text-secondary">Số điện thoại <span class="text-danger">*</span></label>
                <input type="tel" name="Phone" class="form-control rounded-3 py-2"
                       value="@(Model != null ? Model.Phone : "")"
                       placeholder="Nhập 10-11 chữ số..."
                       pattern="[0-9]{10,11}" maxlength="11"
                       title="Số điện thoại phải gồm 10 hoặc 11 chữ số" required />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold small text-secondary">Email đăng nhập (Không thể thay đổi)</label>
                <input type="email" class="form-control rounded-3 py-2 bg-light text-muted" value="@(Model != null ? Model.Email : "")" readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold small text-secondary">Ngày tham gia hệ thống</label>
                <input type="text" class="form-control rounded-3 py-2 bg-light text-muted"
                       value="@(Model != null ? string.Format("{0:dd/MM/yyyy}", Model.CreatedAt) : "Đang cập nhật")" readonly />
            </div>
        </div>

        <hr class="my-4 text-muted opacity-25" />

        <!-- NÚT THAO TÁC (THEO VAI TRÒ) -->
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <button type="submit" class="btn text-white fw-bold px-4 py-2 rounded-3 shadow-sm" style="background-color: #f7931e; border: none;">
                Lưu thay đổi
            </button>

            <div class="d-flex gap-2">
                @if (isRecruiter)
                {
                    <a href="@Url.Action("MyJobs", "Jobs")" class="btn btn-outline-secondary fw-semibold px-3 py-2 rounded-3 small">
                        Quản lý tin đăng
                    </a>
                    <a href="@Url.Action("MyCompany", "Companies")" class="btn btn-light border fw-semibold px-3 py-2 rounded-3 small text-dark">
                        Công ty của tôi
                    </a>
                }
                else if (isAdmin)
                {
                    <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary fw-semibold px-3 py-2 rounded-3 small">
                        Quản trị hệ thống
                    </a>
                }
                else
                {
                    <a href="@Url.Action("MyApplications", "Applications")" class="btn btn-outline-secondary fw-semibold px-3 py-2 rounded-3 small">
                        Xem đơn ứng tuyển
                    </a>
                    <a href="@Url.Action("Index", "Jobs")" class="btn btn-light border fw-semibold px-3 py-2 rounded-3 small text-dark">
                        Tìm việc làm
                    </a>
                }
            </div>
        </div>
    }
</div>