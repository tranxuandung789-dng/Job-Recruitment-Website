@model Job_Recruitment_Website.Models.CATEGORy
@using Job_Recruitment_Website.Models

@{
    ViewBag.Title = "Chi tiết ngành nghề";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";

    var jobsInCat = new List<JOB>();
    if (Model != null)
    {
        using (var db = new RecruitmentDBEntities())
        {
            jobsInCat = db.JOBS
                          .Include("COMPANy")
                          .Where(j => j.CategoryId == Model.CategoryId)
                          .OrderByDescending(j => j.PostedDate)
                          .ToList();
        }
    }

    int openJobsCount = jobsInCat.Count(j => j.Status == "Open");
    int totalJobsCount = jobsInCat.Count;
}

<div class="job-create-card mb-4">
    <!-- HEADER -->
    <div class="job-create-header d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="job-create-icon">
                <i class="bi bi-layers-fill"></i>
            </div>
            <div>
                <h3 class="fw-bold text-dark mb-1" style="font-size: 22px;">@Model.CategoryName</h3>
                <p class="text-muted small mb-0">Thông tin chi tiết danh mục và danh sách các tin tuyển dụng trực thuộc</p>
            </div>
        </div>

        <span class="cat-id-badge">Mã ngành: #@Model.CategoryId</span>
    </div>

    <!-- BODY -->
    <div class="job-create-body">
        <!-- 3 Ô THỐNG KÊ -->
        <div class="mycomp-stats-row">
            <div class="mycomp-stat-box">
                <div class="mycomp-stat-icon st-jobs">
                    <i class="bi bi-tag-fill"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 15px;">@Model.CategoryName</div>
                    <div class="text-muted small fw-semibold">Tên danh mục</div>
                </div>
            </div>

            <div class="mycomp-stat-box">
                <div class="mycomp-stat-icon st-open">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark fs-5" style="line-height: 1.1;">@openJobsCount</div>
                    <div class="text-muted small fw-semibold">Tin đang mở tuyển</div>
                </div>
            </div>

            <div class="mycomp-stat-box">
                <div class="mycomp-stat-icon st-apps">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark fs-5" style="line-height: 1.1;">@totalJobsCount</div>
                    <div class="text-muted small fw-semibold">Tổng số tin thuộc ngành</div>
                </div>
            </div>
        </div>

        <!-- DANH SÁCH TIN TUYỂN DỤNG THUỘC NGÀNH -->
        <h6 class="job-section-subtitle">Danh sách việc làm thuộc ngành @Model.CategoryName</h6>

        @if (!jobsInCat.Any())
        {
            <div class="p-4 bg-light border rounded-3 text-center text-muted small mb-4">
                Hiện chưa có tin tuyển dụng nào thuộc ngành nghề này.
            </div>
        }
        else
        {
            <div class="myjobs-card mb-4">
                <div class="table-responsive">
                    <table class="myjobs-table">
                        <thead>
                            <tr>
                                <th>Tiêu đề công việc</th>
                                <th>Công ty</th>
                                <th>Địa điểm</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in jobsInCat)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details", "Jobs", new { id = job.JobId })" class="myjobs-job-title mb-0">
                                            @job.Title
                                        </a>
                                    </td>
                                    <td class="fw-semibold text-secondary">
                                        @(job.COMPANy != null ? job.COMPANy.CompanyName : "Đang cập nhật")
                                    </td>
                                    <td class="text-muted">
                                        <i class="bi bi-geo-alt text-orange me-1"></i>@job.Location
                                    </td>
                                    <td class="text-center">
                                        @if (job.Status == "Open")
                                        {
                                            <span class="myjobs-status-badge st-open">Đang mở</span>
                                        }
                                        else
                                        {
                                            <span class="myjobs-status-badge st-closed">Đã đóng</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <hr class="my-4 text-secondary opacity-25" />

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a href="@Url.Action("Edit", new { id = Model.CategoryId })" class="btn-submit-job d-inline-flex align-items-center gap-2">
                <i class="bi bi-pencil-square"></i>
                <span>Chỉnh sửa tên ngành</span>
            </a>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-back-job d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i>
                <span>Quay lại danh sách</span>
            </a>
        </div>
    </div>
</div>