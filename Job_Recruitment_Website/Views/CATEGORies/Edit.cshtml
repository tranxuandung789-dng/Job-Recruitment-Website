@model Job_Recruitment_Website.Models.CATEGORy

@{
    ViewBag.Title = "Sửa ngành nghề";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white my-3" style="max-width: 600px;">
    <h3 class="fw-bold text-dark mb-1">Cập nhật ngành nghề</h3>
    <p class="text-muted small mb-4">Chỉnh sửa tên ngành nghề #@Model.CategoryId.</p>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })
        @Html.HiddenFor(model => model.CategoryId)

        <div class="mb-4">
            <label class="form-label fw-semibold">Tên ngành nghề <span class="text-danger">*</span></label>
            @Html.TextBoxFor(model => model.CategoryName, new { @class = "form-control rounded-3 py-2", required = "required" })
            @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger small" })
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary-custom px-4 py-2">Lưu thay đổi</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4 py-2 rounded-3">Quay lại</a>
        </div>
    }
</div>