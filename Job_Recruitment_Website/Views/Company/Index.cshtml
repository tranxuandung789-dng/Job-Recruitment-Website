
@{
    ViewBag.Title = "Danh sách công ty";
    Layout = "~/Views/Shared/_LayoutPageTrangChu.cshtml";
}

<main id="company-page">

    <!-- Tiêu đề trang Công ty -->
    <section id="company-page-header">
        <h1>Khám phá các công ty</h1>
        <p>
            Tìm hiểu về các doanh nghiệp và khám phá
            cơ hội nghề nghiệp tại D-Jobs.
        </p>
    </section>

    <!-- Khu vực tìm kiếm công ty -->
    <section id="company-search">
        <h2>Tìm kiếm công ty</h2>

        <form method="get">

            <div class="form-group">
                <label for="Keyword">Tên công ty</label>
                <input type="text"
                       id="Keyword"
                       name="keyword"
                       placeholder="Nhập tên công ty cần tìm">
            </div>

            <div class="form-group">
                <label for="Location">Địa điểm</label>
                <input type="text"
                       id="Location"
                       name="location"
                       placeholder="Nhập tỉnh/thành phố">
            </div>

            <button type="submit">Tìm công ty</button>

        </form>
    </section>

    <!-- Khu vực danh sách công ty -->
    <section id="company-list">
        <h2>Danh sách công ty tuyển dụng</h2>

        <!-- Backend: Lấy danh sách công ty từ SQL Server -->

    </section>

    <!-- Khu vực phân trang -->
    <nav id="company-pagination" aria-label="Phân trang công ty">

        <!-- Backend: Xử lý phân trang danh sách công ty -->

    </nav>

</main>
