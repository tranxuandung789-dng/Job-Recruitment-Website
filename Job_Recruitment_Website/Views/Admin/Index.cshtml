@model IEnumerable<Job_Recruitment_Website.Models.USER>

@{
    ViewBag.Title = "Trang quản trị Admin";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<div class="container" style="margin-top: 20px;">
    <h2>Bảng điều khiển Quản trị viên (Admin Dashboard)</h2>
    <hr />

    <!-- Thống kê nhanh -->
    <div class="row text-center" style="margin-bottom: 30px;">
        <div class="col-md-3">
            <div class="well" style="background-color: #d9edf7; padding: 15px; border-radius: 5px;">
                <h3>@ViewBag.TotalUsers</h3>
                <p><strong>Người dùng</strong></p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="well" style="background-color: #dff0d8; padding: 15px; border-radius: 5px;">
                <h3>@ViewBag.TotalCompanies</h3>
                <p><strong>Công ty</strong></p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="well" style="background-color: #fcf8e3; padding: 15px; border-radius: 5px;">
                <h3>@ViewBag.TotalJobs</h3>
                <p><strong>Tin tuyển dụng</strong></p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="well" style="background-color: #f2dede; padding: 15px; border-radius: 5px;">
                <h3>@ViewBag.TotalApplications</h3>
                <p><strong>Đơn ứng tuyển</strong></p>
            </div>
        </div>
    </div>

    <!-- Quản lý danh sách tài khoản -->
    <h4>Danh sách tài khoản hệ thống</h4>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Họ và tên</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.UserId</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@(item.ROLE != null ? item.ROLE.RoleName : "")</td>
                    <td>
                        @if (item.IsActive == true)
                        {
                            <span class="label label-success" style="color: green; font-weight: bold;">Hoạt động</span>
                        }
                        else
                        {
                            <span class="label label-danger" style="color: red; font-weight: bold;">Đã khóa</span>
                        }
                    </td>
                    <td>
                        @using (Html.BeginForm("ToggleUserStatus", "Admin", new { id = item.UserId }, FormMethod.Post, new { style = "display:inline;" }))
                        {
                            <button type="submit" class="btn btn-sm @(item.IsActive == true ? "btn-warning" : "btn-success")">
                                @(item.IsActive == true ? "Khóa" : "Mở khóa")
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>