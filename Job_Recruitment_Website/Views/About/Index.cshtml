
@{
    ViewBag.Title = "Về chúng tôi";
    Layout = "~/Views/Shared/_LayoutPageTrangChu.cshtml";
}

<main id="about-page">

    <!-- Phần giới thiệu D-Jobs -->
    <section id="about-introduction">
        <h1>Về chúng tôi</h1>

        <h2>D-Jobs - Kết nối nhân tài, kiến tạo tương lai</h2>

        <p>
            D-Jobs là nền tảng kết nối giữa người tìm việc
            và các nhà tuyển dụng, giúp quá trình tìm kiếm
            việc làm và tuyển dụng trở nên thuận tiện, hiệu quả hơn.
        </p>
    </section>

    <!-- Giới thiệu tổng quan -->
    <section id="about-overview">
        <h2>Giới thiệu về D-Jobs</h2>

        <p>
            Với mong muốn xây dựng cầu nối giữa người lao động
            và doanh nghiệp, D-Jobs hướng đến việc cung cấp
            môi trường tìm kiếm việc làm và tuyển dụng minh bạch,
            thuận tiện và chuyên nghiệp.
        </p>

        <p>
            Chúng tôi mong muốn giúp ứng viên tiếp cận những
            cơ hội nghề nghiệp phù hợp, đồng thời hỗ trợ doanh
            nghiệp tìm kiếm nguồn nhân lực chất lượng.
        </p>
    </section>

    <!-- Tầm nhìn -->
    <section id="about-vision">
        <h2>Tầm nhìn</h2>

        <p>
            Trở thành nền tảng kết nối việc làm đáng tin cậy,
            góp phần xây dựng thị trường lao động năng động
            và phát triển.
        </p>
    </section>

    <!-- Sứ mệnh -->
    <section id="about-mission">
        <h2>Sứ mệnh</h2>

        <p>
            Kết nối đúng người với đúng công việc, hỗ trợ
            doanh nghiệp tuyển dụng hiệu quả và giúp ứng viên
            phát triển con đường sự nghiệp.
        </p>
    </section>

    <!-- Giá trị cốt lõi -->
    <section id="about-values">
        <h2>Giá trị cốt lõi</h2>

        <article class="value-item">
            <h3>Kết nối</h3>
            <p>Tạo cầu nối giữa ứng viên và nhà tuyển dụng.</p>
        </article>

        <article class="value-item">
            <h3>Uy tín</h3>
            <p>Hướng đến sự minh bạch và đáng tin cậy trong tuyển dụng.</p>
        </article>

        <article class="value-item">
            <h3>Phát triển</h3>
            <p>Đồng hành cùng ứng viên và doanh nghiệp trên hành trình phát triển.</p>
        </article>
    </section>

    <!-- Lời kết -->
    <section id="about-conclusion">
        <h2>Cùng D-Jobs phát triển sự nghiệp của bạn</h2>

        <p>
            Hãy bắt đầu hành trình tìm kiếm cơ hội nghề nghiệp
            và kết nối với những nhà tuyển dụng phù hợp ngay hôm nay.
        </p>

        <a href="@Url.Action("Index", "Job")">Khám phá việc làm</a>
    </section>

</main>
