@model Job_Recruitment_Website.Models.JOB

@{
    ViewBag.Title = "Chi tiết công việc";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";

    bool isExpired = Model.Deadline < DateTime.Today;
    int daysLeft = (Model.Deadline.Date - DateTime.Today).Days;
    string companyName = Model.COMPANy != null ? Model.COMPANy.CompanyName : "Chưa cập nhật";
    string companyLogo = Model.COMPANy != null ? Model.COMPANy.Logo_Url : null;
    string cleanDesc = Model.Description != null ? Model.Description.Trim() : "";
}

<!-- THÔNG BÁO TRẠNG THÁI -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger rounded-3 py-2 small fw-semibold mb-3">
        ⚠ @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success rounded-3 py-2 small fw-semibold mb-3">
        ✔ @TempData["Success"]
    </div>
}

<div class="job-detail-card mb-4">
    <!-- HEADER TIN TUYỂN DỤNG -->
    <div class="job-detail-header">
        <div class="job-detail-brand">
            @if (!string.IsNullOrEmpty(companyLogo))
            {
                <img src="@companyLogo" alt="@companyName" class="job-detail-logo" />
            }
            else
            {
                <div class="job-detail-logo-fallback">
                    <i class="bi bi-building"></i>
                </div>
            }

            <div>
                <h2 class="job-detail-title">@Model.Title</h2>
                @if (Model.COMPANy != null)
                {
                    <a href="@Url.Action("Details", "Companies", new { id = Model.CompanyId })" class="job-detail-company-link">
                        <i class="bi bi-building-check text-orange"></i>
                        <span>@companyName</span>
                    </a>
                }
                else
                {
                    <span class="job-detail-company-link">
                        <i class="bi bi-building text-orange"></i>
                        <span>@companyName</span>
                    </span>
                }
            </div>
        </div>

        <div>
            @if (Model.Status == "Open" && !isExpired)
            {
                <span class="job-status-pill status-open">
                    <i class="bi bi-check-circle-fill"></i> Đang mở ứng tuyển
                </span>
            }
            else if (isExpired)
            {
                <span class="job-status-pill status-expired">
                    <i class="bi bi-exclamation-circle-fill"></i> Đã hết hạn nộp
                </span>
            }
            else
            {
                <span class="job-status-pill status-closed">
                    <i class="bi bi-lock-fill"></i> Đã đóng
                </span>
            }
        </div>
    </div>

    <!-- NỘI DUNG CHI TIẾT -->
    <div class="job-detail-body">
        <!-- LƯỚI THÔNG TIN NHANH -->
        <div class="job-meta-grid">
            <div class="job-meta-item">
                <div class="job-meta-icon icon-salary">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <div class="job-meta-label">Mức lương</div>
                    <div class="job-meta-value val-salary">
                        @(string.IsNullOrEmpty(Model.SalaryRange) ? "Thỏa thuận" : Model.SalaryRange)
                    </div>
                </div>
            </div>

            <div class="job-meta-item">
                <div class="job-meta-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div>
                    <div class="job-meta-label">Địa điểm làm việc</div>
                    <div class="job-meta-value">@Model.Location</div>
                </div>
            </div>

            <div class="job-meta-item">
                <div class="job-meta-icon">
                    <i class="bi bi-grid-fill"></i>
                </div>
                <div>
                    <div class="job-meta-label">Ngành nghề</div>
                    <div class="job-meta-value">
                        @(Model.CATEGORy != null ? Model.CATEGORy.CategoryName : "Chưa phân loại")
                    </div>
                </div>
            </div>

            <div class="job-meta-item">
                <div class="job-meta-icon">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
                <div>
                    <div class="job-meta-label">Ngày đăng tin</div>
                    <div class="job-meta-value">@Model.PostedDate.ToString("dd/MM/yyyy")</div>
                </div>
            </div>

            <div class="job-meta-item" style="grid-column: span 2;">
                <div class="job-meta-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="job-meta-label">Hạn chót nộp hồ sơ</div>
                    <div class="job-meta-value @(isExpired ? "text-danger" : "")">
                        @Model.Deadline.ToString("dd/MM/yyyy")
                        @if (!isExpired && Model.Status == "Open")
                        {
                            <span class="small fw-semibold text-orange ms-1">
                                (@(daysLeft == 0 ? "Hết hạn hôm nay" : "Còn " + daysLeft + " ngày"))
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- MÔ TẢ CHI TIẾT CÔNG VIỆC -->
        <div>
            <h5 class="job-section-subtitle">Mô tả chi tiết công việc</h5>
            <div class="job-desc-box">@cleanDesc</div>
        </div>

        <!-- KHU VỰC NÚT BẤM -->
        <div class="job-detail-footer">
            <a href="@Url.Action("Index", "Jobs")" class="btn btn-outline-secondary btn-back-job d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i>
                <span>Quay lại danh sách việc làm</span>
            </a>

            <div>
                @if (Session["Role"] != null && Session["Role"].ToString() == "Candidate")
                {
                    if (Model.Status == "Open" && !isExpired)
                    {
                        <a href="@Url.Action("Apply", "Applications", new { jobId = Model.JobId })" class="btn-apply-detail">
                            <i class="bi bi-send-fill"></i>
                            <span>Ứng tuyển ngay</span>
                        </a>
                    }
                    else if (isExpired)
                    {
                        <button class="btn btn-danger px-4 py-2 rounded-3 fw-bold" disabled>Đã quá hạn ứng tuyển</button>
                    }
                    else
                    {
                        <button class="btn btn-secondary px-4 py-2 rounded-3 fw-bold" disabled>Tin đã đóng</button>
                    }
                }
                else if (Session["Role"] == null)
                {
                    if (Model.Status == "Open" && !isExpired)
                    {
                        <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Apply", "Applications", new { jobId = Model.JobId }) })" class="btn-apply-detail">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Đăng nhập để ứng tuyển</span>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary px-4 py-2 rounded-3 fw-bold" disabled>Không còn nhận hồ sơ</button>
                    }
                }
            </div>
        </div>
    </div>
</div>