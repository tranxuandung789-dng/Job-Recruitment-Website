@model Job_Recruitment_Website.Models.JOB

@{
    ViewBag.Title = "Chi tiết công việc";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<div class="container my-4" style="max-width: 900px;">
    <!-- Thông báo lỗi hoặc thành công nếu có -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2 class="text-primary fw-bold mb-1">@Model.Title</h2>
                    <h5 class="text-muted mb-0">
                        <i class="bi bi-building"></i> @(Model.COMPANy != null ? Model.COMPANy.CompanyName : "Chưa cập nhật")
                    </h5>
                </div>
                <div>
                    @if (Model.Status == "Open")
                    {
                        <span class="badge bg-success fs-6 px-3 py-2">Đang mở ứng tuyển</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6 px-3 py-2">Đã đóng</span>
                    }
                </div>
            </div>

            <hr />

            <!-- Thông tin nhanh về công việc -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <p class="mb-2"><strong>Ngành nghề:</strong> @(Model.CATEGORy != null ? Model.CATEGORy.CategoryName : "Chưa phân loại")</p>
                    <p class="mb-2"><strong>Mức lương:</strong> <span class="text-danger fw-bold">@(string.IsNullOrEmpty(Model.SalaryRange) ? "Thỏa thuận" : Model.SalaryRange)</span></p>
                    <p class="mb-2"><strong>Địa điểm làm việc:</strong> @Model.Location</p>
                </div>
                <div class="col-md-6">
                    <p class="mb-2"><strong>Ngày đăng tin:</strong> @Model.PostedDate.ToString("dd/MM/yyyy")</p>
                    <p class="mb-2"><strong>Hạn chót nộp hồ sơ:</strong> <span class="text-primary fw-bold">@Model.Deadline.ToString("dd/MM/yyyy")</span></p>
                </div>
            </div>

            <!-- Khung mô tả chi tiết công việc -->
            <div class="mb-4">
                <h5 class="fw-bold text-dark">Mô tả chi tiết công việc:</h5>
                <div class="p-3 bg-light rounded border" style="white-space: pre-line; line-height: 1.6;">
                    @Model.Description
                </div>
            </div>

            <!-- Khu vực thao tác nút Ứng tuyển & Quay lại -->
            <div class="pt-3 border-top d-flex align-items-center justify-content-between">
                <div>
                    @Html.ActionLink("← Quay lại danh sách việc làm", "Index", "Jobs", null, new { @class = "btn btn-outline-secondary" })
                </div>

                <div>
                    @if (Session["Role"] != null && Session["Role"].ToString() == "Candidate")
                    {
                        if (Model.Status == "Open")
                        {
                            <a href="@Url.Action("Apply", "Applications", new { jobId = Model.JobId })" class="btn btn-primary btn-lg px-4 shadow-sm">
                                Ứng tuyển ngay
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-lg" disabled>Tin đã đóng</button>
                        }
                    }
                    else if (Session["Role"] == null)
                    {
                        <span class="text-muted me-2 small">Đăng nhập tài khoản Ứng viên để nộp hồ sơ:</span>
                        @Html.ActionLink("Đăng nhập để ứng tuyển", "Login", "Account", null, new { @class = "btn btn-primary" })
                    }
                </div>
            </div>
        </div>
    </div>
</div>