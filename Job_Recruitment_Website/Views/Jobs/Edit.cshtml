@model Job_Recruitment_Website.Models.JOB

@{
    ViewBag.Title = "Sửa tin tuyển dụng";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<div class="container my-4" style="max-width: 800px;">
    <h2 class="fw-bold mb-4">Sửa tin tuyển dụng</h2>

    @using (Html.BeginForm("Edit", "Jobs", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.JobId)

        <div class="mb-3">
            <label class="form-label fw-semibold">Tiêu đề công việc</label>
            @Html.TextBoxFor(model => model.Title, new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Mô tả chi tiết</label>
            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 6, required = "required" })
            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Mức lương</label>
            @Html.TextBoxFor(model => model.SalaryRange, new { @class = "form-control", required = "required", placeholder = "VD: 15 - 20 triệu VND" })
            @Html.ValidationMessageFor(model => model.SalaryRange, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Địa điểm làm việc</label>
            @Html.TextBoxFor(model => model.Location, new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.Location, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Hạn chót nộp hồ sơ</label>
            <input type="date" name="Deadline" class="form-control" required
                   value="@Model.Deadline.ToString("yyyy-MM-dd")" />
            @Html.ValidationMessageFor(model => model.Deadline, "", new { @class = "text-danger" })
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Ngành nghề</label>
            @Html.DropDownList("CategoryId", null, "-- Chọn ngành --", new { @class = "form-select", required = "required" })
            @Html.ValidationMessageFor(model => model.CategoryId, "", new { @class = "text-danger" })
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn text-white fw-bold px-4" style="background-color: #f7931e;">Lưu thay đổi</button>
            @Html.ActionLink("Quay lại danh sách", "MyJobs", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>