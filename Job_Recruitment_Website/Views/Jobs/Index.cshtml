@model IEnumerable<Job_Recruitment_Website.Models.JOB>
@using Job_Recruitment_Website.Models

@{
    ViewBag.Title = "Tin tuyển dụng";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";

    List<CATEGORy> categories;
    using (var db = new RecruitmentDBEntities())
    {
        categories = db.CATEGORIES.ToList();
    }

    int? selectedCat = null;
    int parsedCat;
    if (!string.IsNullOrEmpty(Request.QueryString["categoryId"]) && int.TryParse(Request.QueryString["categoryId"], out parsedCat))
    {
        selectedCat = parsedCat;
    }

    string searchKeyword = Request.QueryString["search"];
    string selectedLoc = Request.QueryString["location"];

    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : (Model != null ? Model.Count() : 0);
}

<!-- THÔNG BÁO TRẠNG THÁI -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger rounded-3 py-2 small fw-semibold mb-3">
        ⚠ @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success rounded-3 py-2 small fw-semibold mb-3">
        ✔ @TempData["Success"]
    </div>
}

<!-- TIÊU ĐỀ TRANG -->
<div class="job-section-header mb-3 d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-0">Tin tuyển dụng</h2>
    </div>
    <span class="text-muted small fw-semibold">
        Hiển thị <strong>@(Model != null ? Model.Count() : 0)</strong> / <strong>@totalItems</strong> việc làm
    </span>
</div>

<!-- THANH TÌM KIẾM VÀ DROPDOWN NGÀNH NGHỀ -->
<form method="get" action="@Url.Action("Index", "Jobs")" class="d-flex gap-2 mb-4 align-items-center">
    @if (!string.IsNullOrEmpty(selectedLoc))
    {
        <input type="hidden" name="location" value="@selectedLoc" />
    }

    <input type="text"
           name="search"
           value="@searchKeyword"
           placeholder="Tìm theo công việc, công ty, địa điểm..."
           class="form-control rounded-3"
           style="height: 44px; color: #1e293b; font-weight: 500; border: 1px solid #ced4da; font-size: 14.5px;" />

    <select name="categoryId"
            onchange="this.form.submit()"
            class="form-select rounded-3"
            style="height: 44px; width: 230px; flex-shrink: 0; color: #334155; border: 1px solid #ced4da; font-size: 14.5px;">
        <option value="">Tất cả ngành nghề</option>
        @foreach (var cat in categories)
        {
            <option value="@cat.CategoryId" @(selectedCat == cat.CategoryId ? "selected" : "")>
                @cat.CategoryName
            </option>
        }
    </select>

    <!-- Nút Tìm kiếm nền cam chữ trắng thương hiệu D-Jobs -->
    <button type="submit"
            class="btn text-white px-4 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
            style="height: 44px; background-color: #f7931e; border: none; white-space: nowrap; font-size: 14.5px; font-weight: 600; letter-spacing: 0.3px;">
        <i class="bi bi-search text-white"></i>
        <span>Tìm kiếm</span>
    </button>
</form>

<!-- LƯỚI CARD VIỆC LÀM 2 CỘT -->
<div id="job-list-results">
    @if (Model == null || !Model.Any())
    {
        <div class="p-4 bg-white border rounded-3 text-muted col-12">
            Không tìm thấy tin tuyển dụng nào phù hợp.
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="job-card">
                <div>
                    <div class="job-card-top">
                        <h3 class="title">
                            <a href="@Url.Action("Details", "Jobs", new { id = item.JobId })">@item.Title</a>
                        </h3>
                        <span class="badge-open">@item.Status</span>
                    </div>

                    <div class="company d-flex align-items-center gap-2 mb-2">
                        @if (item.COMPANy != null && !string.IsNullOrEmpty(item.COMPANy.Logo_Url))
                        {
                            <img src="@item.COMPANy.Logo_Url" alt="@item.COMPANy.CompanyName" style="width: 24px; height: 24px; object-fit: contain; border-radius: 4px;" />
                        }
                        <strong>@(item.COMPANy != null ? item.COMPANy.CompanyName : "Đang cập nhật")</strong>
                        <span>• @item.Location</span>
                    </div>

                    <div class="salary">
                        @(string.IsNullOrEmpty(item.SalaryRange) ? "Thỏa thuận" : item.SalaryRange)
                    </div>

                    <p class="desc">@item.Description</p>
                </div>

                <div>
                    <div class="job-card-meta">
                        <span class="badge-category">
                            @(item.CATEGORy != null ? item.CATEGORy.CategoryName : "Chưa phân loại")
                        </span>
                        <span class="deadline">
                            Hạn nộp: @string.Format("{0:dd/MM/yyyy}", item.Deadline)
                        </span>
                    </div>

                    <!-- Nút Ứng tuyển: Tự động chuyển qua Login kèm returnUrl nếu chưa đăng nhập -->
                    @if (Session["UserId"] == null)
                    {
                        <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Apply", "Applications", new { jobId = item.JobId }) })" class="btn-apply">
                            Ứng tuyển
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Apply", "Applications", new { jobId = item.JobId })" class="btn-apply">
                            Ứng tuyển
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- THANH PHÂN TRANG (PAGINATION) NÚT TRÒN MÀU CAM D-JOBS -->
@if (totalPages > 1)
{
    <nav aria-label="Phân trang tin tuyển dụng" class="mt-3 mb-4">
        <ul class="pagination justify-content-center align-items-center gap-2 mb-0">
            <!-- Nút Trang trước (Tròn) -->
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link rounded-circle d-flex align-items-center justify-content-center border p-0"
                   style="width: 38px; height: 38px; @(currentPage <= 1 ? "background-color: #f1f5f9; border-color: #e2e8f0; color: #cbd5e1;" : "background-color: #ffffff; border-color: #f7931e !important; color: #f7931e;")"
                   href="@Url.Action("Index", "Jobs", new { search = searchKeyword, categoryId = selectedCat, location = selectedLoc, page = currentPage - 1 })"
                   title="Trang trước">
                    <i class="bi bi-chevron-left" style="font-size: 14px; -webkit-text-stroke: 0.5px;"></i>
                </a>
            </li>

            <!-- Danh sách số trang (Tròn) -->
            @for (int i = 1; i <= totalPages; i++)
            {
                bool isActive = (i == currentPage);
                <li class="page-item @(isActive ? "active" : "")">
                    <a class="page-link rounded-circle d-flex align-items-center justify-content-center fw-bold border p-0"
                       style="width: 38px; height: 38px; font-size: 14px; @(isActive ? "background-color: #f7931e; border-color: #f7931e !important; color: #ffffff;" : "background-color: #ffffff; color: #1e293b;")"
                       href="@Url.Action("Index", "Jobs", new { search = searchKeyword, categoryId = selectedCat, location = selectedLoc, page = i })">
                        @i
                    </a>
                </li>
            }

            <!-- Nút Trang sau (Tròn) -->
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link rounded-circle d-flex align-items-center justify-content-center border p-0"
                   style="width: 38px; height: 38px; @(currentPage >= totalPages ? "background-color: #f1f5f9; border-color: #e2e8f0; color: #cbd5e1;" : "background-color: #ffffff; border-color: #f7931e !important; color: #f7931e;")"
                   href="@Url.Action("Index", "Jobs", new { search = searchKeyword, categoryId = selectedCat, location = selectedLoc, page = currentPage + 1 })"
                   title="Trang sau">
                    <i class="bi bi-chevron-right" style="font-size: 14px; -webkit-text-stroke: 0.5px;"></i>
                </a>
            </li>
        </ul>
    </nav>
}