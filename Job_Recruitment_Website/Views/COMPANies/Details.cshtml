@model Job_Recruitment_Website.Models.COMPANy
@using Job_Recruitment_Website.Models

@{
    ViewBag.Title = Model.CompanyName;
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";

    var openJobsList = new List<JOB>();
    if (Model != null)
    {
        using (var db = new RecruitmentDBEntities())
        {
            openJobsList = db.JOBS
                             .Include("CATEGORy")
                             .Where(j => j.CompanyId == Model.CompanyId && j.Status == "Open")
                             .OrderByDescending(j => j.PostedDate)
                             .ThenByDescending(j => j.JobId)
                             .ToList();
        }
    }

    string logoUrl = Model != null ? Model.Logo_Url : null;
    if (!string.IsNullOrEmpty(logoUrl) && logoUrl.StartsWith("http://localhost"))
    {
        Uri uri = new Uri(logoUrl);
        logoUrl = uri.AbsolutePath;
    }

    bool hasRealLogo = !string.IsNullOrWhiteSpace(logoUrl)
                       && logoUrl.IndexOf("via.placeholder.com", StringComparison.OrdinalIgnoreCase) < 0;

    string cleanDesc = !string.IsNullOrWhiteSpace(Model.Description)
        ? Model.Description.Trim()
        : "Chưa có thông tin mô tả chi tiết cho công ty này.";
}

@functions {
    public string GetCompanyInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "DJ";
        string cleaned = name.Trim();
        string[] prefixes = { "công ty tnhh", "công ty cổ phần", "công ty cp", "tổng công ty", "tập đoàn", "công ty" };
        foreach (var p in prefixes)
        {
            if (cleaned.ToLower().StartsWith(p))
            {
                cleaned = cleaned.Substring(p.Length).Trim();
                break;
            }
        }
        var parts = cleaned.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return (parts[0].Substring(0, 1) + parts[1].Substring(0, 1)).ToUpper();
        }
        return cleaned.Length >= 2 ? cleaned.Substring(0, 2).ToUpper() : cleaned.ToUpper();
    }
}

<!-- KHUNG HỒ SƠ CHI TIẾT DOANH NGHIỆP -->
<div class="comp-detail-card">
    <!-- Dải ảnh bìa thương hiệu + Nút quay lại + Số tin đang mở -->
    <div class="comp-detail-cover">
        <a href="@Url.Action("Index", "Companies")" class="btn-comp-back-top">
            <i class="bi bi-arrow-left"></i>
            <span>Danh sách công ty</span>
        </a>

        <span class="comp-detail-open-badge">
            <i class="bi bi-briefcase-fill"></i>
            <span>@openJobsList.Count vị trí đang mở</span>
        </span>
    </div>

    <div class="comp-detail-body">
        <!-- Logo nổi & Tên công ty -->
        <div class="comp-detail-identity">
            <div class="comp-detail-logo-frame">
                @if (hasRealLogo)
                {
                    <img src="@logoUrl" alt="@Model.CompanyName"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="comp-detail-monogram" style="display:none;">@GetCompanyInitials(Model.CompanyName)</div>
                }
                else
                {
                    <div class="comp-detail-monogram">@GetCompanyInitials(Model.CompanyName)</div>
                }
            </div>

            <div class="comp-detail-title-wrap">
                <h2 class="comp-detail-name">@Model.CompanyName</h2>
                <div class="comp-detail-partner">
                    <i class="bi bi-patch-check-fill"></i>
                    <span>Nhà tuyển dụng đối tác tại D-JOBS</span>
                </div>
            </div>
        </div>

        <!-- Địa chỉ & Website -->
        <div class="comp-detail-meta-grid">
            <div class="comp-detail-meta-box">
                <i class="bi bi-geo-alt-fill"></i>
                <div>
                    <div class="text-muted small fw-semibold mb-1">Địa chỉ trụ sở</div>
                    <div class="fw-bold text-dark" style="font-size: 14px; line-height: 1.45;">
                        @(string.IsNullOrWhiteSpace(Model.Address) ? "Đang cập nhật địa chỉ" : Model.Address)
                    </div>
                </div>
            </div>

            <div class="comp-detail-meta-box">
                <i class="bi bi-globe2"></i>
                <div>
                    <div class="text-muted small fw-semibold mb-1">Website doanh nghiệp</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Website))
                    {
                        <a href="@Model.Website" target="_blank" class="fw-bold text-orange" style="font-size: 14px; word-break: break-all;">
                            @Model.Website <i class="bi bi-box-arrow-up-right small ms-1"></i>
                        </a>
                    }
                    else
                    {
                        <div class="text-muted fw-semibold" style="font-size: 14px;">Chưa cập nhật website</div>
                    }
                </div>
            </div>
        </div>

        <!-- Giới thiệu công ty -->
        <div>
            <h5 class="job-section-subtitle">Giới thiệu công ty</h5>
            <div class="job-desc-box">@cleanDesc</div>
        </div>
    </div>
</div>

<!-- DANH SÁCH VIỆC LÀM ĐANG TUYỂN DỤNG CỦA CÔNG TY -->
<div class="job-section-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h3 class="fw-bold text-dark mb-1" style="font-size: 20px;">
            Việc làm đang tuyển dụng từ <span class="text-orange">@Model.CompanyName</span>
        </h3>
        <p class="text-muted small mb-0">Ứng tuyển trực tiếp vào các vị trí phù hợp với năng lực của bạn</p>
    </div>
</div>

@if (!openJobsList.Any())
{
    <div class="p-4 bg-white border rounded-4 text-center text-muted mb-4">
        <i class="bi bi-inbox fs-3 text-orange d-block mb-2"></i>
        Hiện tại công ty chưa có tin tuyển dụng nào đang mở.
    </div>
}
else
{
    <div class="comp-jobs-grid">
        @foreach (var job in openJobsList)
        {
            <div class="job-card">
                <div>
                    <div class="job-card-top">
                        <h3 class="title">
                            <a href="@Url.Action("Details", "Jobs", new { id = job.JobId })">@job.Title</a>
                        </h3>
                        <span class="badge-open">@job.Status</span>
                    </div>

                    <div class="company mb-2">
                        <i class="bi bi-geo-alt text-orange me-1"></i>@job.Location
                    </div>

                    <div class="salary">
                        @(string.IsNullOrEmpty(job.SalaryRange) ? "Thỏa thuận" : job.SalaryRange)
                    </div>

                    <p class="desc">@job.Description</p>
                </div>

                <div>
                    <div class="job-card-meta">
                        <span class="badge-category">
                            @(job.CATEGORy != null ? job.CATEGORy.CategoryName : "Chưa phân loại")
                        </span>
                        <span class="deadline">
                            Hạn nộp: @job.Deadline.ToString("dd/MM/yyyy")
                        </span>
                    </div>

                    <div class="job-card-actions">
                        @if (Session["UserId"] == null)
                        {
                            <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Apply", "Applications", new { jobId = job.JobId }) })" class="btn-apply">
                                Ứng tuyển
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Apply", "Applications", new { jobId = job.JobId })" class="btn-apply">
                                Ứng tuyển
                            </a>
                        }

                        <a href="@Url.Action("Details", "Jobs", new { id = job.JobId })" class="btn-job-detail">
                            <span>Chi tiết việc làm</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}