@model Job_Recruitment_Website.Models.COMPANy

@{
    ViewBag.Title = "Chỉnh sửa thông tin công ty";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";

    string logoUrl = Model != null ? Model.Logo_Url : null;
    if (!string.IsNullOrEmpty(logoUrl) && logoUrl.StartsWith("http://localhost"))
    {
        Uri uri = new Uri(logoUrl);
        logoUrl = uri.AbsolutePath;
    }

    bool hasRealLogo = !string.IsNullOrWhiteSpace(logoUrl)
                       && logoUrl.IndexOf("via.placeholder.com", StringComparison.OrdinalIgnoreCase) < 0;
}

@functions {
    public string GetCompanyInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "DJ";
        string cleaned = name.Trim();
        string[] prefixes = { "công ty tnhh", "công ty cổ phần", "công ty cp", "tổng công ty", "tập đoàn", "công ty" };
        foreach (var p in prefixes)
        {
            if (cleaned.ToLower().StartsWith(p))
            {
                cleaned = cleaned.Substring(p.Length).Trim();
                break;
            }
        }
        var parts = cleaned.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return (parts[0].Substring(0, 1) + parts[1].Substring(0, 1)).ToUpper();
        }
        return cleaned.Length >= 2 ? cleaned.Substring(0, 2).ToUpper() : cleaned.ToUpper();
    }
}

<div class="comp-edit-card mb-4">
    <!-- HEADER FORM -->
    <div class="job-create-header d-flex align-items-center gap-3">
        <div class="job-create-icon">
            <i class="bi bi-building-gear"></i>
        </div>
        <div>
            <h3 class="fw-bold text-dark mb-1" style="font-size: 22px;">Chỉnh sửa thông tin công ty</h3>
            <p class="text-muted small mb-0">Cập nhật hồ sơ thương hiệu doanh nghiệp của bạn trên hệ thống D-JOBS</p>
        </div>
    </div>

    <!-- BODY FORM -->
    <div class="job-create-body">
        @using (Html.BeginForm("Edit", "Companies", FormMethod.Post, new { enctype = "multipart/form-data", id = "editCompanyForm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small rounded-3 mb-3" })
            @Html.HiddenFor(model => model.CompanyId)
            @Html.HiddenFor(model => model.UserId)

            <div class="row g-3">
                <!-- 1. KHUNG LOGO HIỆN TẠI & CHỌN LOGO MỚI -->
                <div class="col-12 mb-1">
                    <label class="job-label">
                        <i class="bi bi-image-fill"></i>
                        <span>Logo thương hiệu công ty</span>
                    </label>

                    <div class="comp-logo-editor">
                        <div class="comp-logo-preview-frame">
                            <img id="logo-preview-img"
                                 src="@(hasRealLogo ? logoUrl : "")"
                                 alt="@Model.CompanyName"
                                 style="@(hasRealLogo ? "display:block;" : "display:none;")"
                                 onerror="this.style.display='none'; document.getElementById('logo-monogram-box').style.display='flex';" />

                            <div id="logo-monogram-box"
                                 class="mycomp-monogram"
                                 style="@(hasRealLogo ? "display:none;" : "display:flex;") font-size: 24px;">
                                @GetCompanyInitials(Model.CompanyName)
                            </div>
                        </div>

                        <div class="comp-logo-editor-info">
                            <input type="file" id="logoFile" name="logoFile" class="form-control job-input bg-white" accept=".jpg,.jpeg,.png" />
                            <div class="text-muted small mt-2">
                                <i class="bi bi-info-circle text-orange me-1"></i>
                                Chấp nhận định dạng <strong>.JPG, .JPEG, .PNG</strong>. Để trống nếu bạn muốn giữ nguyên logo hiện tại.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. TÊN CÔNG TY -->
                <div class="col-md-7">
                    <label class="job-label" for="CompanyName">
                        <i class="bi bi-building-fill"></i>
                        <span>Tên công ty <span class="text-danger">*</span></span>
                    </label>
                    @Html.TextBoxFor(model => model.CompanyName, new
                    {
                        @class = "form-control job-input",
                        id = "CompanyName",
                        maxlength = "200",
                        placeholder = "Nhập tên đầy đủ của doanh nghiệp..."
                    })
                    <div class="invalid-feedback" id="err-CompanyName">
                        Vui lòng nhập tên công ty.
                    </div>
                    @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger small" })
                </div>

                <!-- 3. WEBSITE -->
                <div class="col-md-5">
                    <label class="job-label" for="Website">
                        <i class="bi bi-globe2"></i>
                        <span>Website doanh nghiệp</span>
                    </label>
                    @Html.TextBoxFor(model => model.Website, new
                    {
                        @class = "form-control job-input",
                        id = "Website",
                        maxlength = "255",
                        placeholder = "https://tencongty.vn"
                    })
                    <div class="invalid-feedback" id="err-Website">
                        Địa chỉ website phải bắt đầu bằng http:// hoặc https://
                    </div>
                    @Html.ValidationMessageFor(model => model.Website, "", new { @class = "text-danger small" })
                </div>

                <!-- 4. ĐỊA CHỈ TRỤ SỞ -->
                <div class="col-12">
                    <label class="job-label" for="Address">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>Địa chỉ trụ sở <span class="text-danger">*</span></span>
                    </label>
                    @Html.TextBoxFor(model => model.Address, new
                    {
                        @class = "form-control job-input",
                        id = "Address",
                        maxlength = "255",
                        placeholder = "VD: Tòa nhà Bitexco, Quận 1, TP. Hồ Chí Minh"
                    })
                    <div class="invalid-feedback" id="err-Address">
                        Vui lòng nhập địa chỉ trụ sở công ty.
                    </div>
                    @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger small" })
                </div>

                <!-- 5. MÔ TẢ GIỚI THIỆU CÔNG TY -->
                <div class="col-12">
                    <label class="job-label" for="Description">
                        <i class="bi bi-file-earmark-text-fill"></i>
                        <span>Mô tả giới thiệu công ty</span>
                    </label>
                    @Html.TextAreaFor(model => model.Description, new
                    {
                        @class = "form-control job-input",
                        id = "Description",
                        rows = 5,
                        placeholder = "Giới thiệu về lĩnh vực hoạt động, quy mô nhân sự, môi trường làm việc và chế độ phúc lợi..."
                    })
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger small" })
                </div>
            </div>

            <hr class="my-4 text-secondary opacity-25" />

            <!-- NÚT LƯU & QUAY LẠI -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="submit" class="btn-submit-job d-inline-flex align-items-center gap-2">
                    <i class="bi bi-check2-circle"></i>
                    <span>Lưu thay đổi</span>
                </button>

                <a href="@Url.Action("MyCompany", "Companies")" class="btn btn-outline-secondary btn-back-job d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    <span>Quay lại</span>
                </a>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var form = document.getElementById('editCompanyForm');
            if (!form) return;

            var compName = document.getElementById('CompanyName');
            var address = document.getElementById('Address');
            var website = document.getElementById('Website');
            var logoInput = document.getElementById('logoFile');
            var previewImg = document.getElementById('logo-preview-img');
            var monogramBox = document.getElementById('logo-monogram-box');

            // Hiển thị ảnh xem trước ngay trong khung vuông khi chọn file mới
            if (logoInput && previewImg && monogramBox) {
                logoInput.addEventListener('change', function () {
                    setTimeout(function () {
                        if (logoInput.files && logoInput.files[0]) {
                            previewImg.style.display = 'block';
                            monogramBox.style.display = 'none';
                        }
                    }, 25);
                });
            }

            function setInvalid(input, errId, isInvalid, msg) {
                if (!input) return;
                var errEl = document.getElementById(errId);
                if (errEl && msg) errEl.textContent = msg;
                input.classList.toggle('is-invalid', isInvalid);
            }

            function checkName(forceEmptyCheck) {
                var v = compName.value.trim();
                if (v.length === 0) {
                    setInvalid(compName, 'err-CompanyName', forceEmptyCheck, 'Vui lòng nhập tên công ty.');
                    return false;
                }
                setInvalid(compName, 'err-CompanyName', false);
                return true;
            }

            function checkAddress(forceEmptyCheck) {
                var v = address.value.trim();
                if (v.length === 0) {
                    setInvalid(address, 'err-Address', forceEmptyCheck, 'Vui lòng nhập địa chỉ trụ sở công ty.');
                    return false;
                }
                setInvalid(address, 'err-Address', false);
                return true;
            }

            function checkWebsite() {
                var v = website.value.trim();
                if (v.length === 0) {
                    setInvalid(website, 'err-Website', false);
                    return true;
                }
                var ok = /^https?:\/\/[^\s]+$/i.test(v);
                setInvalid(website, 'err-Website', !ok, 'Website nên bắt đầu bằng http:// hoặc https:// (VD: https://momo.vn).');
                return ok;
            }

            compName.addEventListener('input', function () { checkName(false); });
            compName.addEventListener('blur', function () { checkName(true); });

            address.addEventListener('input', function () { checkAddress(false); });
            address.addEventListener('blur', function () { checkAddress(true); });

            website.addEventListener('input', checkWebsite);
            website.addEventListener('blur', checkWebsite);

            form.addEventListener('submit', function (e) {
                var okName = checkName(true);
                var okAddr = checkAddress(true);
                var okWeb = checkWebsite();

                if (!okName || !okAddr || !okWeb) {
                    e.preventDefault();
                    var firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) firstInvalid.focus();
                }
            });
        })();
    </script>
}