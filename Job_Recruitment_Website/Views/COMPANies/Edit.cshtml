@model Job_Recruitment_Website.Models.COMPANy

@{
    ViewBag.Title = "Chỉnh sửa thông tin công ty";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white mb-4" style="max-width: 760px;">
    <h3 class="fw-bold text-dark mb-1">Chỉnh sửa thông tin công ty</h3>
    <p class="text-muted small mb-4">Cập nhật hồ sơ doanh nghiệp của bạn trên hệ thống D-JOBS.</p>

    @using (Html.BeginForm("Edit", "Companies", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })
        @Html.HiddenFor(model => model.CompanyId)
        @Html.HiddenFor(model => model.UserId)

        <div class="mb-3">
            <label class="form-label fw-semibold">Tên công ty <span class="text-danger">*</span></label>
            @Html.TextBoxFor(model => model.CompanyName, new { @class = "form-control rounded-3 py-2", required = "required", placeholder = "Nhập tên công ty..." })
            @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Logo công ty (.jpg, .jpeg, .png)</label>
            <input type="file" name="logoFile" class="form-control rounded-3 py-2" accept=".jpg,.jpeg,.png" />
            @if (!string.IsNullOrEmpty(Model.Logo_Url))
            {
                <div class="mt-2 d-flex align-items-center gap-3">
                    <span class="text-muted small">Logo hiện tại:</span>
                    <img src="@Model.Logo_Url" alt="@Model.CompanyName"
                         style="max-height: 60px; max-width: 140px; object-fit: contain; border: 1px solid #e6e9ef; border-radius: 8px; padding: 4px;" />
                </div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Địa chỉ trụ sở <span class="text-danger">*</span></label>
            @Html.TextBoxFor(model => model.Address, new { @class = "form-control rounded-3 py-2", required = "required", placeholder = "Nhập địa chỉ công ty..." })
            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Website</label>
            @Html.TextBoxFor(model => model.Website, new { @class = "form-control rounded-3 py-2", placeholder = "https://example.com" })
            @Html.ValidationMessageFor(model => model.Website, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Mô tả giới thiệu công ty</label>
            @Html.TextAreaFor(model => model.Description, new { @class = "form-control rounded-3", rows = 5, placeholder = "Giới thiệu về lĩnh vực hoạt động, quy mô và văn hóa doanh nghiệp..." })
            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger small" })
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary-custom px-4 py-2">Lưu thay đổi</button>
            <a href="@Url.Action("MyCompany", "Companies")" class="btn btn-outline-secondary px-4 py-2 rounded-3">Quay lại</a>
        </div>
    }
</div>