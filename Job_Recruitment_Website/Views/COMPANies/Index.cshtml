@model IEnumerable<Job_Recruitment_Website.Models.COMPANy>

@{
    ViewBag.Title = "Danh sách công ty";
    Layout = "~/Views/Shared/_LayoutPageRecruitment.cshtml";
}

<!-- TIÊU ĐỀ TRANG -->
<div class="job-section-header mb-4">
    <h2>Danh sách Công ty đối tác</h2>
    <p class="text-muted">Khám phá các doanh nghiệp hàng đầu đang tuyển dụng nhân tài tại D-JOBS.</p>
</div>

<!-- LƯỚI HIỂN THỊ CÔNG TY -->
<div class="company-grid-results">
    @if (Model == null || !Model.Any())
    {
        <div class="p-4 bg-white border rounded-3 text-muted w-100">
            Chưa có thông tin công ty nào.
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="company-card">
                <!-- Phần Logo công ty (Tự động đồng bộ thông minh với dữ liệu) -->
                <div class="company-logo-box">
                    @{
                        string logoUrl = item.Logo_Url;

                        // Nếu trong CSDL chưa có hoặc để trống thì dùng ảnh mặc định
                        if (string.IsNullOrEmpty(logoUrl))
                        {
                            logoUrl = Url.Content("~/Content/Images/Logo.png");
                        }
                        // Nếu trong CSDL lưu link localhost cũ, tự lọc lại
                        else if (logoUrl.StartsWith("http://localhost"))
                        {
                            Uri uri = new Uri(logoUrl);
                            logoUrl = uri.AbsolutePath;
                        }
                        // Nếu là link ngoài (như fptsoftware.com/logo.png dễ bị gãy),
                        // ta có thể giữ nguyên hoặc cho nó tự động fallback sang ảnh mặc định khi lỗi bằng Javascript bên dưới.
                    }
                    <img src="@logoUrl" alt="@item.CompanyName"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/150?text=@HttpUtility.UrlEncode(item.CompanyName)';" />
                </div>

                <!-- Phần Thông tin -->
                <div class="company-info-content">
                    <h3 class="company-title">
                        <a href="@Url.Action("Details", "Companies", new { id = item.CompanyId })">@item.CompanyName</a>
                    </h3>

                    <p class="company-address">
                        <i class="me-1">Địa chỉ: </i> @(string.IsNullOrEmpty(item.Address) ? "Đang cập nhật địa chỉ" : item.Address)
                    </p>

                    <p class="company-desc">
                        @(item.Description != null && item.Description.Length > 90 ? item.Description.Substring(0, 90) + "..." : (item.Description ?? "Chưa có mô tả chi tiết cho công ty này."))
                    </p>
                </div>

                <!-- Nút xem chi tiết -->
                <div class="mt-3 pt-3 border-top">
                    <a href="@Url.Action("Details", "Companies", new { id = item.CompanyId })" class="btn-view-company">
                        Xem chi tiết công ty
                    </a>
                </div>
            </div>
        }
    }
</div>